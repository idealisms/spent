{
  "name": "tracker",
  "version": "0.1.0",
  "description": "Web GUI",
  "main": "index.js",
  "license": "UNLICENSED",
  "scripts": {
    "build:webpack": "NODE_ENV=production webpack --mode=production --config config/webpack.prod.config.js --progress --profile",
    "build": "npm run clean && npm run build:webpack",
    "build:analyze": "ANALYZE=1 npm run build",
    "clean": "rimraf build",
    "deploy": "npm run build && scp -r build/* google_cloud.tailscale:~/www/spent/",
    "watch": "NODE_ENV=development webpack --mode=development --config config/webpack.dev.config.js --watch --progress --profile",
    "start": "npm run clean && webpack-dev-server --mode=development --config config/webpack.dev.config.js --progress --profile",
    "test": "vitest run --config config/vitest.config.mts",
    "test:watch": "vitest --config config/vitest.config.mts",
    "test:e2e": "vitest run --config config/vitest.e2e.config.mts",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --write ."
  },
  "bugs": {
    "url": "https://github.com/idealisms/spent/issues"
  },
  "homepage": "https://github.com/idealisms/spent/",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/google.visualization": "^0.0.75",
    "@types/jsdom": "^30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/redux-logger": "^3.0.7",
    "@types/sha.js": "^2.4.0",
    "css-loader": "^7.1.2",
    "esbuild-loader": "^4.5.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.3.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.6",
    "puppeteer": "^25.16.0",
    "redux-logger": "^3.0.6",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.2.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "workbox-webpack-plugin": "7"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/x-date-pickers": "^9.17.0",
    "buffer": "^6.0.3",
    "classnames": "^2.2.6",
    "dropbox": "^10.34.0",
    "memoize-one": "^6.0.0",
    "moment": "^2.31.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-google-charts": "^5.2.1",
    "react-redux": "9",
    "react-router-dom": "^7.18.3",
    "react-select": "5",
    "redux": "5",
    "redux-thunk": "^3.1.0",
    "sha.js": "^2.4.12",
    "tss-react": "^4.9.21"
  },
  "resolutions": {
    "minimatch": "9.0.7",
    "serialize-javascript": "7.0.3",
    "glob": "^10.5.0"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "packageManager": "yarn@4.18.1"
}
